{
  "name": "nostr-relay-nestjs",
  "version": "2.2.0",
  "description": "A high-performance nostr relay, using PostgreSQL",
  "author": "codytseng",
  "private": true,
  "packageManager": "bun@1.3.13",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodyTseng/nostr-relay-nestjs"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "migration:run": "bun scripts/migrate-to-latest.ts",
    "migration:revert": "bun scripts/migrate-down.ts",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "bun dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:check": "eslint --max-warnings 0 \"{src,apps,libs,test}/**/*.ts\""
  },
  "dependencies": {
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/schedule": "^4.1.1",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^5.2.0",
    "@nestjs/websockets": "^10.4.4",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@nostr-relay/common": "^0.0.36",
    "@nostr-relay/core": "^0.0.36",
    "@nostr-relay/created-at-limit-guard": "^0.0.3",
    "@nostr-relay/or-guard": "^0.0.4",
    "@nostr-relay/pow-guard": "^0.0.3",
    "@nostr-relay/throttler": "^0.0.5",
    "@nostr-relay/validator": "^0.0.36",
    "@nostr-relay/wot-guard": "^0.0.11",
    "@nostrify/nostrify": "^0.52.0",
    "another-nestjs-ws-adapter": "^10.1.0",
    "hbs": "^4.2.0",
    "helmet": "^8.0.0",
    "kysely": "^0.27.4",
    "lodash": "^4.17.21",
    "meilisearch": "^0.43.0",
    "meilisearch-helper": "^1.2.0",
    "nestjs-pino": "^4.1.0",
    "nostr-tools": "^2.7.2",
    "pg": "^8.13.0",
    "pino-http": "^10.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tdigest": "^0.1.2",
    "zod": "^4.3.6",
    "zod-validation-error": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@types/express": "^5.0.0",
    "@types/hbs": "^4.0.4",
    "@types/lodash": "^4.17.9",
    "@types/node": "18.15.3",
    "@types/pg": "^8.11.10",
    "@types/tdigest": "^0.1.4",
    "@types/ws": "^8.5.12",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^9.11.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "^15.10.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0"
  }
}
